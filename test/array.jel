module main

import std

function main() {
    mut array = std.alloc(100, `size_of[[:4]i64])

    for i = 0; i < array.length; i + 1 {
        for j = 0; j < 4; j + 1 {
            array[i][j] = i + j
        }
    }

    for i = 0; i < array.length; i + 1 {
        for j = 0; j < 4; j + 1 {
            std.print_int(array[i][j])
            std.print_str(&"\n")
        }
    }
}
