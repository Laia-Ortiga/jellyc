module main

import gl

struct Sky {
    shader i32,
    loc_colors i32,
}

public function init_sky() -> Sky {
    let shader = compile_shader_program(&[
        compile_shader(gl.VERTEX_SHADER, &"shaders/sky.vert"),
        compile_shader(gl.FRAGMENT_SHADER, &"shaders/sky.frag"),
    ])
    (
        shader = shader,
        loc_colors = gl.glGetUniformLocation(shader, &"colors"[0]),
    )
}

public function draw_sky(sky Sky, colors [:9]f32) {
    gl.glUseProgram(sky.shader)
    gl.glUniformMatrix3fv(sky.loc_colors, 1, false, &{&colors}![0])
    gl.glDepthMask(false)
    gl.glDrawArrays(gl.TRIANGLE_STRIP, 0, 4)
    gl.glDepthMask(true)
}