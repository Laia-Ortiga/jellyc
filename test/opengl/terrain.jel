module main

import libc
import gl

struct Terrain {
    height_map_texture i32,
    shader i32,
    vao i32,
    ebo i32,
    height_map @mut f32,
}

const terrain_grid_size = <i32> 1536
const grid_factor = <i32> 16

function small_grid_size() -> i16 {
    <i16> `cast[terrain_grid_size] / <i16> `cast[grid_factor]
}

function small_grid_rows() -> i16 {
    small_grid_size() + 1
}

function index_count() -> i32 {
    <i32> `cast[small_grid_size()] * <i32> `cast[small_grid_size()] * 4
}

function create_height_map_texture(seed i32) -> i32 {
    mut texture = <i32> 0
    gl.glGenTextures(1, &texture)
	gl.glBindTexture(gl.TEXTURE_2D, texture)
	gl.glTexStorage2D(gl.TEXTURE_2D, 1, gl.R16F, terrain_grid_size + 1, terrain_grid_size + 1)
	gl.glTexParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
	gl.glTexParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
	gl.glTexParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST)
	gl.glTexParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST)
    gl.glBindImageTexture(0, texture, 0, false, 0, gl.WRITE_ONLY, gl.R16F)

    let central_island_min = <f32> 46.0  # ceil(64 * sqrt(0.5))
    let central_island_max = central_island_min + 128.0
    let program = compile_shader_program(&[
        compile_shader(gl.COMPUTE_SHADER, &"shaders/terrain/height_gen.comp"[0]),
    ])
    gl.glUseProgram(program)
    gl.glUniform1ui(gl.glGetUniformLocation(program, &"seed"[0]), seed)
    gl.glUniform2f(gl.glGetUniformLocation(program, &"central_island"[0]), central_island_min, central_island_max)
    gl.glDispatchCompute(terrain_grid_size + 1, terrain_grid_size + 1, 1)
    gl.glUseProgram(0)
    gl.glDeleteProgram(program)

    texture
}

function create_ebo() -> i32 {
    mut indices = alloc(<isize> `cast[index_count()], `size_of[i16])
    mut i = <isize> 0
    for z = <i16> 0; z < small_grid_size(); z + 1 {
        for x = <i16> 0; x < small_grid_size(); x + 1 {
            indices[i] = (z + 1) * small_grid_rows() + x
            indices[i + 1] = z * small_grid_rows() + x
            indices[i + 2] = z * small_grid_rows() + x + 1
            indices[i + 3] = (z + 1) * small_grid_rows() + x + 1
            i += 4
        }
    }
    mut buffer = <i32> 0
    gl.glGenBuffers(1, &buffer)
    gl.glBindBuffer(gl.ELEMENT_ARRAY_BUFFER, buffer)
    gl.glBufferStorage(gl.ELEMENT_ARRAY_BUFFER, `size_of[i16] * <isize> `cast[index_count()], indices.data, 0)
    free(indices)
    buffer
}

public function init_terrain(seed i32) -> Terrain {
    let height_map_texture = create_height_map_texture(seed)

    let shader = compile_shader_program(&[
        compile_shader(gl.VERTEX_SHADER, &"shaders/terrain/terrain.vert"[0]),
        compile_shader(gl.TESS_CONTROL_SHADER, &"shaders/terrain/terrain.tesc"[0]),
        compile_shader(gl.TESS_EVALUATION_SHADER, &"shaders/terrain/terrain.tese"[0]),
        compile_shader(gl.FRAGMENT_SHADER, &"shaders/terrain/terrain.frag"[0]),
    ])
    gl.glUseProgram(shader)
    gl.glUniform1f(gl.glGetUniformLocation(shader, &"tile_size"[0]), 1.0 / <f32> `cast[terrain_grid_size])
    mut vao = <i32> 0
    gl.glGenVertexArrays(1, &vao)
    gl.glBindVertexArray(vao)
    let ebo = create_ebo()
    gl.glBindVertexArray(0)
	gl.glPatchParameteri(gl.PATCH_VERTICES, 4)

    gl.glBindTexture(gl.TEXTURE_2D, height_map_texture)
    let height_map = alloc(<isize> `cast[(terrain_grid_size + 1) * (terrain_grid_size + 1)], `size_of[f32])
    gl.glGetTexImage(gl.TEXTURE_2D, 0, gl.RED, gl.FLOAT, height_map.data)
    Terrain(
        height_map_texture,
        shader,
        vao,
        ebo,
        height_map,
    )
}

public function draw_terrain(terrain Terrain) {
    gl.glActiveTexture(gl.TEXTURE3)
    gl.glBindTexture(gl.TEXTURE_2D, terrain.height_map_texture)
    gl.glUseProgram(terrain.shader)
    gl.glBindVertexArray(terrain.vao)
    gl.glDrawElements(gl.PATCHES, index_count(), gl.UNSIGNED_SHORT, null)
    gl.glBindVertexArray(0)
}
