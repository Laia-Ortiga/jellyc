module glfw

public const CursorPosFun = function(window *mut byte, xpos f64, ypos f64)
public const KeyFun = function(window *mut byte, key i32, scancode i32, action i32, mods i32)
public const MouseButtonFun = function(window *mut byte, button i32, action i32, mods i32)

extern function glfwInit() -> i32
public const init = glfwInit
extern function glfwCreateWindow(width i32, height i32, title *i8, v *i8, a *i8) -> *mut byte
public const createWindow = glfwCreateWindow
extern function glfwMakeContextCurrent(window *mut byte)
public const makeContextCurrent = glfwMakeContextCurrent
extern function glfwGetCursorPos(window *mut byte, xpos *f64, ypos *f64)
public const getCursorPos = glfwGetCursorPos
extern function glfwGetWindowUserPointer(window *mut byte) -> *mut byte
public const getWindowUserPointer = glfwGetWindowUserPointer
extern function glfwSetWindowUserPointer(window *mut byte, pointer *mut byte)
public const setWindowUserPointer = glfwSetWindowUserPointer
extern function glfwSetCursorPosCallback(window *mut byte, callback CursorPosFun) -> CursorPosFun
public const setCursorPosCallback = glfwSetCursorPosCallback
extern function glfwSetMouseButtonCallback(window *mut byte, callback MouseButtonFun) -> MouseButtonFun
public const setMouseButtonCallback = glfwSetMouseButtonCallback
extern function glfwSetKeyCallback(window *mut byte, callback KeyFun) -> KeyFun
public const setKeyCallback = glfwSetKeyCallback
extern function glfwWindowShouldClose(window *mut byte) -> i32
public const windowShouldClose = glfwWindowShouldClose
extern function glfwGetProcAddress(procname *i8) -> function()
public const getProcAddress = glfwGetProcAddress
extern function glfwTerminate()
public const terminate = glfwTerminate
extern function glfwSwapBuffers(window *mut byte)
public const swapBuffers = glfwSwapBuffers
extern function glfwPollEvents()
public const pollEvents = glfwPollEvents

public const MOUSE_BUTTON_1 = <i32> 0
public const MOUSE_BUTTON_2 = <i32> 1
public const MOUSE_BUTTON_3 = <i32> 2
public const MOUSE_BUTTON_4 = <i32> 3
public const MOUSE_BUTTON_5 = <i32> 4
public const MOUSE_BUTTON_6 = <i32> 5
public const MOUSE_BUTTON_7 = <i32> 6
public const MOUSE_BUTTON_8 = <i32> 7
public const MOUSE_BUTTON_LAST = MOUSE_BUTTON_8
public const MOUSE_BUTTON_LEFT = MOUSE_BUTTON_1
public const MOUSE_BUTTON_RIGHT = MOUSE_BUTTON_2
public const MOUSE_BUTTON_MIDDLE = MOUSE_BUTTON_3

public const RELEASE = <i32> 0
public const PRESS = <i32> 1
public const REPEAT = <i32> 2

public const KEY_LEFT_SHIFT = <i32> 340
