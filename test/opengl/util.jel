module main

import gl
import libc
import std

function assert_program_status(program i32, pname i32) {
    mut status = <i32> 0
    gl.glGetProgramiv(program, pname, &status)

    if status == gl.FALSE {
        mut log_length = <i32> 0
        gl.glGetProgramiv(program, gl.INFO_LOG_LENGTH, &log_length)
        mut log = std.alloc(<isize> `cast[log_length], `size_of[i8])
        gl.glGetProgramInfoLog(program, log_length, null, &log[0])
        std.print_str(&"Couldn't link shader program")
        libc.puts(&log[0])
        libc.exit(-1)
    }
}

function compile_shader(type i32, file_name @i8) -> i32 {
    let code = std.read_file(file_name)

    if code.length == 0 {
        std.print_str(&"Couldn't load shader")
        libc.exit(-1)
    }

    let shader = gl.glCreateShader(type)
    gl.glShaderSource(shader, 1, <**i8> `cast[&code.data], null)
    std.free(code)
    gl.glCompileShader(shader)

    mut compile_status = <i32> 0
    gl.glGetShaderiv(shader, gl.COMPILE_STATUS, &compile_status)

    if compile_status == gl.FALSE {
        mut log_max = <i32> 0
        gl.glGetShaderiv(shader, gl.INFO_LOG_LENGTH, &log_max)
        mut log = std.alloc(<isize> `cast[log_max], `size_of[i8])
        mut log_length = <i32> 0
        gl.glGetShaderInfoLog(shader, log_max, &log_length, &log[0])
        log.length = `cast[log_length]
        std.print_str(&"Error in shader")
        libc.puts(&log[0])
        libc.exit(-1)
    }

    shader
}

function compile_shader_program(shaders @i32) -> i32 {
    let program = gl.glCreateProgram()

    for i = <isize> 0; i < shaders.length; i + 1 {
        gl.glAttachShader(program, shaders[i])
    }

    gl.glLinkProgram(program)
    assert_program_status(program, gl.LINK_STATUS)

    for i = <isize> 0; i < shaders.length; i + 1 {
        gl.glDetachShader(program, shaders[i])
        gl.glDeleteShader(shaders[i])
    }

    gl.glValidateProgram(program)
    assert_program_status(program, gl.VALIDATE_STATUS)
    program
}

function create_ubo(size isize) -> i32 {
    mut ubo = <i32> 0
    gl.glGenBuffers(1, &ubo)
    gl.glBindBuffer(gl.UNIFORM_BUFFER, ubo)
    gl.glBufferStorage(gl.UNIFORM_BUFFER, size, null, gl.MAP_WRITE_BIT)
    gl.glBindBufferRange(gl.UNIFORM_BUFFER, 0, ubo, 0, size)
    ubo
}

function write_ubo[T](ubo i32, offset isize, size `Size[T], data *T) {
    gl.glBindBuffer(gl.UNIFORM_BUFFER, ubo)
    let ptr = gl.glMapBufferRange(
        gl.UNIFORM_BUFFER,
        offset,
        size,
        gl.MAP_WRITE_BIT | gl.MAP_INVALIDATE_BUFFER_BIT | gl.MAP_UNSYNCHRONIZED_BIT,
    )

    if ptr == null {
        libc.exit(-1)
    }

    libc.memcpy(ptr, data, size)

    if !gl.glUnmapBuffer(gl.UNIFORM_BUFFER) {
        libc.exit(-1)
    }
}